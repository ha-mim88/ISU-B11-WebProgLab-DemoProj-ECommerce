@page
@model webapp2.Pages.SlidePages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Slide[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slide[0].Image)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slide[0].URL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slide[0].Seq)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slide[0].Active)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slide[0].CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slide[0].CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slide[0].LastModifiedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slide[0].LastModifiedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Slide) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                <img src="@item.Image" alt="@item.Title" width="100" height="100" />
            </td>
            <td>
                @Html.DisplayFor(model => item.URL)
            </td>
            <td>
                @Html.DisplayFor(model => item.Seq)
            </td>
            <td>
                @Html.DisplayFor(model => item.Active)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.LastModifiedBy)
            </td>
            <td>
                @Html.DisplayFor(model => item.LastModifiedDate)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
